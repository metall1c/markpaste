<?xml version="1.0" encoding="UTF-8"?>
<!-- Description for software centers (AppStream). id = app id = .desktop file name. -->
<component type="desktop-application">
  <id>@MARKPASTE_APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>@MARKPASTE_APP_NAME@</name>
  <summary>Capture, mark and paste screenshots with comments into any chat</summary>
  <summary xml:lang="ru">Снимки с пометками и комментариями — в любой чат одним действием</summary>
  <description>
    <p>
      Press a hotkey, select an area, put numbered marks A1, A2… on it and comment each one.
      One more hotkey pastes the whole set — images and text — into any chat or AI assistant.
    </p>
    <p xml:lang="ru">
      Горячая клавиша — выделить область — поставить нумерованные метки A1, A2… с комментариями.
      Ещё одна клавиша вставляет весь набор, картинки и текст, в любой чат или ИИ-ассистент.
    </p>
  </description>
  <launchable type="desktop-id">@MARKPASTE_APP_ID@.desktop</launchable>
  <url type="homepage">@MARKPASTE_HOMEPAGE_URL@</url>
  <url type="bugtracker">@MARKPASTE_HOMEPAGE_URL@/issues</url>
  <developer id="su.525">
    <name>Andrey</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <caption>Marks with comments in the shot editor</caption>
      <image>https://raw.githubusercontent.com/@MARKPASTE_GITHUB_REPO@/main/docs/images/en/editor.png</image>
    </screenshot>
    <screenshot>
      <caption>The strip with the set of shots</caption>
      <image>https://raw.githubusercontent.com/@MARKPASTE_GITHUB_REPO@/main/docs/images/en/strip-set.png</image>
    </screenshot>
    <screenshot>
      <caption>Preview of what goes to the chat</caption>
      <image>https://raw.githubusercontent.com/@MARKPASTE_GITHUB_REPO@/main/docs/images/en/preview.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.2.0" date="2026-10-21">
      <description>
        <p>The first public release.</p>
      </description>
    </release>
  </releases>
</component>
