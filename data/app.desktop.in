[Desktop Entry]
Type=Application
Name=@MARKPASTE_APP_NAME@
GenericName=Screenshot annotator
GenericName[ru]=Снимки с пометками для чатов
Comment=Capture, mark and paste screenshots with comments into any chat
Comment[ru]=Снять, отметить и вставить снимки с комментариями в любой чат
Exec=@MARKPASTE_DESKTOP_EXEC@
Icon=@MARKPASTE_APP_ID@
Terminal=false
Categories=Qt;Utility;
Keywords=screenshot;annotate;chat;paste;снимок;скриншот;
StartupNotify=false
SingleMainWindow=true
# Fast capture through KWin ScreenShot2 without a dialog (spec section 9). KWin checks
# that the Exec path matches the process executable.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
